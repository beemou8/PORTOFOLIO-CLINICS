PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bim_clinics
JWT_SECRET=ganti-dengan-random-secret-panjang
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiPasswordKuat123!
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@clinic.local

PUBLIC_WEB_URL=http://localhost:5173

# Penyimpanan foto lokal. Bisa absolute path saat production, contoh:
# UPLOAD_DIR=/var/lib/bim-clinics/uploads
# Jika kosong, default ke folder ./uploads di root project.
UPLOAD_DIR=uploads

ADMIN_BRANCH_CODE=MAIN

# Daftar origin frontend yang diizinkan mengakses API saat NODE_ENV=production
# (pisahkan koma untuk multi-domain). Wajib diisi domain produksi asli saat deploy.
# Saat development (NODE_ENV kosong/development), CORS tidak dibatasi supaya
# tidak terhambat oleh localhost vs 127.0.0.1 vs IP jaringan lokal.
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
